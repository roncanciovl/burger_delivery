<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>burger_kinova_reference</name>
  <version>1.0.0</version>
  <description>
    Verificación, monitoreo y uso controlado del enlace ROS 2 entre el proyecto
    burger_delivery y un manipulador Kinova Gen3 de 7 GDL. Incluye el subsistema
    de logging, trazabilidad y caja negra (flight recorder) del curso.
  </description>
  <maintainer email="henry.roncancio@unimilitar.edu.co">Henry Roncancio</maintainer>
  <license>Apache-2.0</license>
  <url type="repository">https://github.com/roncanciovl/burger_delivery</url>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>diagnostic_msgs</exec_depend>
  <exec_depend>control_msgs</exec_depend>
  <exec_depend>trajectory_msgs</exec_depend>
  <exec_depend>controller_manager_msgs</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>kortex_description</exec_depend>

  <!-- MoveIt 2 (Laboratorio 04): planificación en move_group, ejecución en este package.
       moveit_safe_executor y escena_moveit usan los mensajes; el launch
       moveit_planificacion.launch.py, la configuración de MoveIt del Gen3 6 GDL. -->
  <exec_depend>moveit_msgs</exec_depend>
  <exec_depend>shape_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>action_msgs</exec_depend>
  <exec_depend>moveit_ros_move_group</exec_depend>
  <exec_depend>moveit_configs_utils</exec_depend>
  <exec_depend>moveit_planners_ompl</exec_depend>
  <exec_depend>kinova_gen3_6dof_robotiq_2f_85_moveit_config</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <!-- La escena de la celda (mesa, tags) para los obstáculos y las metas de MoveIt -->
  <exec_depend>burger_description</exec_depend>

  <!-- Driver oficial de Kinova: sólo se necesita cuando start_driver:=true -->
  <exec_depend>kortex_bringup</exec_depend>

  <!-- Cámara y visualización de sus extrínsecas -->
  <exec_depend>kinova_vision</exec_depend>
  <exec_depend>compressed_image_transport</exec_depend>

  <!-- Herramientas de logging/registro usadas por el taller asociado -->
  <exec_depend>rosbag2_py</exec_depend>
  <exec_depend>rosbag2_storage_mcap</exec_depend>
  <exec_depend>rqt_console</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
