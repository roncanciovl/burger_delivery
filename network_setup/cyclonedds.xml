<?xml version="1.0" encoding="UTF-8"?>
<!--
  Perfil CycloneDDS del proyecto burger_delivery.

  Uso (idéntico en todas las máquinas):
      export RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
      export CYCLONEDDS_URI=file://$HOME/ros2_ws/src/burger_delivery/network_setup/cyclonedds.xml

  El perfil es PORTABLE: no fija nombres de interfaz, por lo que funciona igual
  en Ubuntu nativo (wlan0/enp*), en WSL2 en modo reflejado (eth*) y en equipos
  con una sola NIC. Solo debe editarse en el caso dual-homed descrito abajo.

  Verificado contra el esquema de CycloneDDS 0.10.x (ros-jazzy-cyclonedds).
  IMPORTANTE: en 0.10 el elemento <NetworkInterfaceAddress> YA NO EXISTE;
  la forma correcta de fijar la interfaz es <Interfaces><NetworkInterface/>.
-->
<CycloneDDS xmlns="https://cdds.io/config"
            xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
            xsi:schemaLocation="https://cdds.io/config https://raw.githubusercontent.com/eclipse-cyclonedds/cyclonedds/master/etc/cyclonedds.xsd">
  <Domain Id="any">
    <General>
      <!--
        Selección automática de la interfaz de salida: CycloneDDS elige la NIC
        activa con multicast disponible. Es lo correcto para un equipo con una
        sola NIC en la subred ROS.

        CASO DUAL-HOMED (una NIC hacia el Kinova y otra hacia la subred ROS):
        la autodetección puede escoger la NIC equivocada y los nodos remotos
        nunca se descubren. Solo en ese caso, comente el bloque automático y
        descomente el manual, sustituyendo el nombre por el de SU equipo
        (véalo con: ip -brief addr).
      -->
      <Interfaces>
        <NetworkInterface autodetermine="true" multicast="default" priority="default"/>
        <!--
        <NetworkInterface name="wlan0" multicast="default" priority="default"/>
        -->
      </Interfaces>

      <AllowMulticast>true</AllowMulticast>

      <!--
        MaxMessageSize: tamaño máximo del payload UDP que genera CycloneDDS.
        FragmentSize:   tamaño de cada fragmento DDSI.

        En Wi-Fi la MTU es 1500 B. Con MaxMessageSize=65500B un solo datagrama
        se parte en ~45 fragmentos IP y basta perder UNO para descartar el
        mensaje completo: con imágenes comprimidas eso se traduce en caídas
        bruscas de 'ros2 topic hz'. Por eso aquí se usan valores conservadores
        que caben en la MTU.

        Para el enlace CABLEADO Gigabit puede subir a:
            <MaxMessageSize>65500B</MaxMessageSize>
            <FragmentSize>4000B</FragmentSize>
        Compare ambos escenarios en la Tabla 4 y en el Análisis 2.
      -->
      <MaxMessageSize>8192B</MaxMessageSize>
      <FragmentSize>1344B</FragmentSize>
    </General>

    <Internal>
      <!--
        Buffer de escritura por writer. Las imágenes comprimidas son ráfagas
        grandes; un WhcHigh pequeño estrangula al publicador en Wi-Fi.
      -->
      <Watermarks>
        <WhcHigh>2MB</WhcHigh>
      </Watermarks>
    </Internal>

    <Discovery>
      <!--
        Si el multicast está bloqueado por el router del laboratorio,
        descomente los Peers y ponga las IP fijas de cada dispositivo de la
        subred ROS (por defecto 192.168.1.0/24).
      -->
      <ParticipantIndex>auto</ParticipantIndex>
      <!--
      <Peers>
        <Peer address="192.168.1.100"/>
        <Peer address="192.168.1.101"/>
      </Peers>
      -->
    </Discovery>

    <Tracing>
      <!-- Suba a 'config' o 'finest' solo para depurar el descubrimiento. -->
      <Verbosity>warning</Verbosity>
    </Tracing>
  </Domain>
</CycloneDDS>
