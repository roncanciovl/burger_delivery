<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>burger_bringup</name>
  <version>0.1.0</version>
  <description>
    Arranque centralizado de Burger-Cell: escena, driver del Kinova, percepción,
    manipulación y telemetría con argumentos de modo (simulation, use_vlm, ...).
  </description>
  <maintainer email="henry.roncancio@unimilitar.edu.co">Henry Roncancio</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>burger_description</exec_depend>
  <exec_depend>burger_kinova_reference</exec_depend>
  <exec_depend>burger_perception</exec_depend>
  <exec_depend>burger_control</exec_depend>
  <exec_depend>burger_telemetry</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
